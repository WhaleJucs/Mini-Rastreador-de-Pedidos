{
  "name": "foody-delivery-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "test": "node --test",
    "test:components": "vitest run --config vitest.config.js",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:hml": "vite build --mode hml",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "verify:env": "node --test src/config/env.test.js && node scripts/verify-environments.mjs"
  },
  "dependencies": {
    "axios": "1.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
