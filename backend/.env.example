# Referência: o Spring NÃO carrega este arquivo automaticamente.
# Injete no processo conforme o README; não cole uma chave neste exemplo.
SPRING_PROFILES_ACTIVE=local
APP_JWT_SECRET_BASE64=

# Defaults exclusivos do perfil local (caminho relativo ao diretório backend).
APP_DB_PATH=./data/foody-local.db
APP_JWT_ISSUER=foody-local
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081

# Defaults compartilhados; valores positivos.
APP_JWT_TTL_SECONDS=3600
APP_DB_BUSY_TIMEOUT_MS=5000
